# Defaults run entirely offline. Merely setting a key never enables live calls.
COMPANION_MODE=mock
COMPANION_DATA_DIR=.local
# Optional; if empty, a local access token is generated in .local/api-token.
COMPANION_API_TOKEN=

# Text / Vision / Memory (HTTP/SSE track)
COMPANION_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
COMPANION_DEEPSEEK_API_KEY=
COMPANION_DIALOGUE_MODEL=deepseek-flash
COMPANION_VISION_MODEL=deepseek-flash
COMPANION_MEMORY_MODEL=deepseek-flash

# Qwen AUDIO 3.1 TTS, Singapore (HTTP/SSE track)
COMPANION_QWEN_TTS_MODEL=qwen-audio-3.1-tts-flash
COMPANION_QWEN_TTS_ENDPOINT=
# Example: https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
COMPANION_QWEN_API_KEY=
COMPANION_QWEN_VOICE=longanhuan_v3.1
COMPANION_SAMPLE_RATE=24000

# MOSS-Live-1.0 Full-Duplex Realtime Voice Track (WebSocket /v1/realtime)
# Billed per connected minute from session_attached; never auto-connects.
COMPANION_MOSS_API_KEY=
COMPANION_MOSS_REALTIME_URL=wss://api.mosi.cn/v1/realtime
COMPANION_MOSS_REST_BASE_URL=https://api.mosi.cn/v1
COMPANION_MOSS_MODEL=moss-live-1.0
# Optional speaker UUID from GET /v1/moss/voices (e.g. 6c3152b1-1d4f-4e49-ade3-09f447712fec)
COMPANION_MOSS_VOICE=
COMPANION_MOSS_PERSONA_NAME=七草荠
COMPANION_MOSS_MEMORY_SCOPE=session
# Required only if COMPANION_MOSS_MEMORY_SCOPE=user
COMPANION_MOSS_USER_ID=
COMPANION_MOSS_OUTPUT_SAMPLE_RATE=24000
COMPANION_MOSS_DELEGATION=none
COMPANION_MOSS_IDLE_TIMEOUT_S=180
COMPANION_MOSS_MAX_CONNECTIONS=1
