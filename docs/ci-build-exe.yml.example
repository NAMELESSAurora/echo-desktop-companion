name: Build Windows EXE & Test

on:
  push:
    branches: [main]
    tags: ["v*"]
  pull_request:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build-and-test:
    runs-on: windows-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: "npm"
          cache-dependency-path: frontend/package-lock.json

      - name: Build and test frontend
        working-directory: frontend
        run: |
          npm ci
          npm run build
          npm test

      - name: Setup uv & Python 3.12
        uses: astral-sh/setup-uv@v5
        with:
          python-version: "3.12"
          enable-cache: true

      - name: Install Python dependencies (dev + desktop)
        run: uv sync --frozen --group dev --group desktop

      - name: Lint and run backend tests
        run: |
          uv run --frozen ruff check src tests scripts
          uv run --frozen ruff format --check src tests scripts
          uv run --frozen pytest -q

      - name: Build and smoke-test EchoCompanion.exe
        run: uv run --frozen --group desktop python scripts/build_exe.py --skip-frontend

      - name: Upload EchoCompanion.exe artifact
        uses: actions/upload-artifact@v4
        with:
          name: EchoCompanion-Windows-x64
          path: dist/EchoCompanion.exe
          if-no-files-found: error

      - name: Attach EXE to GitHub Release (on tag push)
        if: startsWith(github.ref, 'refs/tags/v')
        uses: softprops/action-gh-release@v2
        with:
          files: dist/EchoCompanion.exe
          generate_release_notes: true
